# Required: your Anthropic API key (or run `ant auth login` / set ANTHROPIC_AUTH_TOKEN)
ANTHROPIC_API_KEY=

# Model and reasoning effort
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high            # low | medium | high | xhigh | max
CLAUDE_FALLBACKS=default      # default | off  (server-side refusal fallback)
ENABLE_WEB_SEARCH=1           # lets the assistant search the web for manufacturer literature (each search adds API cost); 0 to disable

# Server
PORT=8787
HOST=127.0.0.1                # set 0.0.0.0 to expose on your LAN (then set APP_PASSWORD)
DB_PATH=./data/hvac.sqlite
APP_PASSWORD=                 # required when HOST is not loopback; enables HTTP basic auth (any username)
REPLAY_IMAGE_WINDOW=10        # user turns whose photos stay in model context (0 = all)
CLAUDE_FAKE=0                 # 1 = demo mode with canned responses (no API key needed)
ALLOW_ORIGINS=                # CORS allowlist for native app shells, e.g. capacitor://localhost,http://localhost
