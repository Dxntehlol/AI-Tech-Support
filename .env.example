# Required for the real assistant: your Anthropic API key (or run `ant auth login` / set ANTHROPIC_AUTH_TOKEN).
# Empty = demo mode with canned responses.
ANTHROPIC_API_KEY=

# Model and reasoning effort
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# default | off  (server-side refusal fallback)
CLAUDE_FALLBACKS=default
# 1 lets the assistant search the web for manufacturer literature (each search adds API cost); 0 to disable
ENABLE_WEB_SEARCH=1
# Tool calls the assistant may make in one turn before it must answer
MAX_TOOL_ITERATIONS=12

# Server
PORT=8787
# 127.0.0.1 = this machine only. Set 0.0.0.0 to expose on your LAN (then APP_PASSWORD is required).
HOST=127.0.0.1
DB_PATH=./data/hvac.sqlite
# Access password for phones (HTTP basic auth, any username; also sent as a Bearer token by the app).
# Required when HOST is not loopback. `node scripts/setup.mjs` generates one when empty.
APP_PASSWORD=
# User turns whose photos stay in model context (0 = all)
REPLAY_IMAGE_WINDOW=10
# 1 = demo mode with canned responses (no API key needed)
CLAUDE_FAKE=0
# CORS allowlist for native app shells, e.g. capacitor://localhost,http://localhost (empty = same-origin only)
ALLOW_ORIGINS=
