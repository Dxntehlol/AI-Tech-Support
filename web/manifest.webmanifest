{
  "id": "hvac-field-assistant",
  "name": "HVAC Field Assistant",
  "short_name": "HVAC Assist",
  "description": "Refrigeration-cycle diagnostics, nameplate decoding, electrical procedures and per-unit job memory for commercial HVAC technicians.",
  "start_url": "./#chat",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0d10",
  "theme_color": "#0b0d10",
  "lang": "en",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/phone-chat.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Chat with the assistant about an attached unit" },
    { "src": "screenshots/phone-readings.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Refrigeration cycle check with live diagnosis" },
    { "src": "screenshots/desktop-chat.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Conversations, chat and the unit panel side by side" }
  ],
  "shortcuts": [
    { "name": "New conversation", "url": "./#chat/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Readings", "url": "./#readings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Units", "url": "./#units", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
